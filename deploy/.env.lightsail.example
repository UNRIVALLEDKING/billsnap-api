# ==============================================================================
# BillSnap Testing Environment Configuration (AWS Lightsail - Port 8002)
# ==============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (Auto-initialized by Docker on first run) ---
POSTGRES_USER=billsnap
POSTGRES_PASSWORD=billsnap_secure_pass_2026!
POSTGRES_DB=billsnap
DATABASE_URL=postgres://billsnap:billsnap_secure_pass_2026!@postgres:5432/billsnap
DB_POOL_SIZE=5

# --- Authentication & Testing Mode ---
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@billsnap.app
DEMO_PASSWORD=Demo@12345
JWT_SECRET=billsnap_jwt_secret_token_testing_lightsail_key_32chars

# --- AI Gemini Model ---
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_MAX_CONCURRENCY=1

# --- Storage: Built-in MinIO Container (Default) ---
# Communicates with the MinIO container inside the docker compose network
S3_ENDPOINT=http://minio:9000
R2_ACCESS_KEY_ID=billsnap
R2_SECRET_ACCESS_KEY=billsnap_secure_storage_key_2026!
R2_BUCKET=billsnap

# --- Storage Alternative: Cloudflare R2 (Optional) ---
# If using Cloudflare R2, comment out S3_ENDPOINT above and uncomment below:
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET=billsnap

# --- Public Domain & Port ---
API_DOMAIN=34.200.182.27:8002
