# BillSnap Testing Deployment Environment Configuration (AWS Lightsail)
# Copy this file to /srv/billsnap/.env on the server and edit values:

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Postgres container credentials)
POSTGRES_USER=billsnap
POSTGRES_PASSWORD=change_this_to_a_secure_password_123!
POSTGRES_DB=billsnap
DATABASE_URL=postgres://billsnap:change_this_to_a_secure_password_123!@postgres:5432/billsnap
DB_POOL_SIZE=5

# Auth & Testing Mode
# DEMO_LOGIN_ENABLED=true enables both demo login and on-screen OTP for testers
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@billsnap.app
DEMO_PASSWORD=Demo@12345
JWT_SECRET=generate_a_random_32_character_secret_string_here_now!

# AI Gemini Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_MAX_CONCURRENCY=1

# Storage: Cloudflare R2 (Recommended - zero RAM footprint, free egress)
# Obtain these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=billsnap-testing

# Caddy Domain/Port
API_DOMAIN=34.200.182.27:8002
