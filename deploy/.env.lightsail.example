# ==============================================================================
# BillSnap Testing Environment Configuration (AWS Lightsail - Port 8002)
# ==============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- PostgreSQL (Auto-initialized by Docker on first run) ---
POSTGRES_USER=billsnap
POSTGRES_PASSWORD=billsnap_secure_pass_2026!
POSTGRES_DB=billsnap
DATABASE_URL=postgres://billsnap:billsnap_secure_pass_2026!@postgres:5432/billsnap
DB_POOL_SIZE=5

# --- Authentication & Testing Mode ---
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@billsnap.app
DEMO_PASSWORD=Demo@12345
JWT_SECRET=billsnap_jwt_secret_token_testing_lightsail_key_32chars

# --- AI Gemini Model ---
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_MAX_CONCURRENCY=1

# --- Storage: SeaweedFS (S3-compatible endpoint) ---
# 172.17.0.1 connects from inside the Docker container to the host where SeaweedFS is running.
S3_ENDPOINT=http://172.17.0.1:8333
R2_ACCESS_KEY_ID=seaweed_admin
R2_SECRET_ACCESS_KEY=seaweed_admin_secret
R2_BUCKET=billsnap

# --- Public Domain & Port ---
API_DOMAIN=34.200.182.27:8002
